# Optional Continuity bridge for Worktrunk.
#
# Copy this file to .config/wt.toml only after `continuity` is installed on
# PATH and you have reviewed the command. Worktrunk asks for approval before
# running project hooks. The hook runs in the new worktree and only prints
# bounded orientation plus live ownership; claims remain explicit.

[pre-start]
continuity_context = "continuity context --scope . --limit 1800"
continuity_status = "continuity status"
